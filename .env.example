# ==============================================================================
# BeautyAnalyzerAI Environment Variables Example
# ==============================================================================

# Backend Server (Railway / Node.js Express)
PORT=3001
DATA_DIR=./server/data
UPLOADS_DIR=./server/uploads
ALLOWED_ORIGIN=*

# Frontend (Cloudflare Pages - optional if hosting frontend separately from Railway)
# Set this on Cloudflare Pages to point to your Railway backend URL:
# VITE_API_URL=https://your-app-name.up.railway.app
